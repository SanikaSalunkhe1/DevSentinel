# ==============================================================================
# DevSentinel Environment Variables Template
# ==============================================================================

# Database Configuration (PostgreSQL 16 + pgvector)
# Note: Host port is set to 5433 to avoid collision with any existing local PostgreSQL on 5432
POSTGRES_USER=devsentinel
POSTGRES_PASSWORD=devsentinel_pass
POSTGRES_DB=devsentinel_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://devsentinel:devsentinel_pass@localhost:5433/devsentinel_db?schema=public

# Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication (Google OAuth 2.0 - to be configured in Module 1)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET=devsentinel-development-jwt-secret-key-32chars-min

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your-gemini-api-key
