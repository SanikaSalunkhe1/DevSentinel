// Prisma Schema for DevSentinel
// Modular Observability & Incident Intelligence Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum AppEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum AppStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model User {
  id           String            @id @default(uuid()) @db.Uuid
  email        String            @unique @db.VarChar(255)
  name         String            @db.VarChar(255)
  avatarUrl    String?           @db.Text
  googleSub    String?           @unique @db.VarChar(255)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)

  // Relationships
  memberships  WorkspaceMember[]
  sessions     Session[]

  @@index([email])
  @@index([googleSub])
  @@map("users")
}

model Workspace {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(255)
  slug        String            @unique @db.VarChar(100)
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(6)

  // Relationships
  members     WorkspaceMember[]
  applications Application[]

  @@index([slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @db.Timestamptz(6)

  // Foreign keys & Cascade
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Constraints & Indexes
  @@unique([workspaceId, userId], name: "uq_workspace_user")
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  token       String    @unique @db.VarChar(255)
  userAgent   String?   @db.Text
  ipAddress   String?   @db.VarChar(45)
  expiresAt   DateTime  @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  // Foreign key & Cascade
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes for fast token lookup and expiration purging
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model Application {
  id            String         @id @default(uuid()) @db.Uuid
  appId         String         @unique @db.VarChar(32)      // human-readable unique ID like "app_a1b2c3d4"
  workspaceId   String         @db.Uuid
  name          String         @db.VarChar(255)
  description   String?        @db.Text
  language      String?        @db.VarChar(50)               // e.g. "TypeScript", "Python", "Go"
  framework     String?        @db.VarChar(50)               // e.g. "Express", "FastAPI", "Gin"
  environment   AppEnvironment @default(DEVELOPMENT)
  status        AppStatus      @default(ACTIVE)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  // Foreign key
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Relationships
  apiKeys       ApiKey[]

  // Indexes
  @@index([workspaceId])
  @@index([appId])
  @@index([status])
  @@map("applications")
}

model ApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  applicationId   String    @db.Uuid
  label           String    @db.VarChar(100)                // human-friendly name e.g. "production-key-1"
  prefix          String    @db.VarChar(12)                 // first 8 chars of key for identification (e.g. "dsk_a1b2")
  keyHash         String    @db.VarChar(128)                // SHA-256 hash of the full key — NEVER store raw
  isActive        Boolean   @default(true)
  revokedAt       DateTime? @db.Timestamptz(6)
  lastUsedAt      DateTime? @db.Timestamptz(6)
  expiresAt       DateTime? @db.Timestamptz(6)              // optional expiry
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  // Foreign key
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([keyHash])                                        // fast lookup on validation
  @@index([applicationId])
  @@index([prefix])
  @@map("api_keys")
}
